# ==============================================================================
# UtilityLens Web (Frontend) — Environment Configuration
# ==============================================================================

# --- Режим работы с API ---
# false — подключение к реальному FastAPI бэкенду
# true  — автономный оффлайн-режим с моковыми сценариями и контрактами
USE_MOCK_API=false

# URL бэкенда UtilityLens:
# - При запуске в Docker Compose: http://backend:8000
# - При локальном запуске (хост): http://localhost:8000
# - При облачном хостинге (VPS/PaaS): https://api.yourdomain.com
API_BASE_URL=http://localhost:8000

# --- Настройки сервера Streamlit для хостинга ---
# Сетевой порт (для хостинга обычно 8501 или 80/443 при прямом бинде)
STREAMLIT_SERVER_PORT=8501

# Сетевой адрес (0.0.0.0 для Docker-контейнеров и внешнего доступа)
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Режим headless для серверов (отключает попытку открыть браузер локально)
STREAMLIT_SERVER_HEADLESS=true

# Настройки CORS и XSRF для работы через Reverse Proxy (Nginx/Traefik/Cloudflare)
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false

# Отключение сбора телеметрии Streamlit
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
