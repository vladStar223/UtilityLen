{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BillDocument",
  "type": "object",
  "required": ["bill_id", "period", "address", "total_amount", "services"],
  "properties": {
    "bill_id": {
      "type": "string",
      "description": "Уникальный идентификатор квитанции"
    },
    "period": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "description": "Расчетный период в формате ГГГГ-ММ"
    },
    "address": {
      "type": "string",
      "description": "Обезличенный адрес жилого помещения"
    },
    "payer": {
      "type": "string",
      "description": "ФИО плательщика (обезличено)"
    },
    "total_amount": {
      "type": "number",
      "description": "Итоговая сумма к оплате в рублях"
    },
    "qr_data": {
      "type": "string",
      "description": "Сырая строка QR-кода по ГОСТ Р 56042-2014"
    },
    "qr_sum_rub": {
      "type": "number",
      "description": "Сумма, извлеченная из QR-кода в рублях"
    },
    "meters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["meter_id", "service_code", "current_reading"],
        "properties": {
          "meter_id": { "type": "string" },
          "service_code": { "type": "string" },
          "prev_reading": { "type": "number" },
          "current_reading": { "type": "number" },
          "verification_due_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["service_code", "raw_name", "unit", "volume", "tariff", "total"],
        "properties": {
          "service_code": { "type": "string", "description": "Канонический код (cold_water, heat, etc.)" },
          "raw_name": { "type": "string", "description": "Оригинальное название из квитанции" },
          "unit": { "type": "string", "description": "Единица измерения (м3, Гкал, кВт.ч)" },
          "volume": { "type": "number", "description": "Объем потребления" },
          "tariff": { "type": "number", "description": "Тариф за единицу измерения" },
          "coefficient": { "type": "number", "default": 1.0, "description": "Повышающий коэффициент (например 1.5)" },
          "recalculation": { "type": "number", "default": 0.0, "description": "Сумма перерасчета" },
          "penalty": { "type": "number", "default": 0.0, "description": "Пени" },
          "total": { "type": "number", "description": "Итоговая сумма по строке" }
        }
      }
    }
  }
}
