# ==============================================================================
# UtilityLens Backend — Переменные окружения (.env.example)
# Скопируйте этот файл в backend/.env: cp .env.example .env
# Все секреты ниже — плейсхолдеры. Замените их на реальные сильные значения.
# ==============================================================================

# --- Сервер ---
PORT=8000
ENVIRONMENT=development

# --- CORS (разрешенные адреса фронтенда и клиентов) ---
CORS_ORIGINS=http://localhost:8501,http://localhost:3000,http://136.234.72.54,http://136.234.72.54:8000,http://25.vibe.fast.ru,http://25.vibe.fast.ru:8000

# --- База данных PostgreSQL ---
# Для локальной разработки без Docker: sqlite:///./test.db
# Для продакшна в Docker: postgresql+psycopg2://postgres:<ПАРОЛЬ>@db:5432/utilitylens
POSTGRES_PASSWORD=your_secure_postgres_password
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_postgres_password@db:5432/utilitylens

# --- Кэш Redis (хранение отчетов факторного анализа) ---
REDIS_PASSWORD=your_secure_redis_password
REDIS_URL=redis://:your_secure_redis_password@redis:6379/0

# --- Безопасность и JWT токены пользователей ---
SECRET_KEY=utilitylens-jwt-secret-key-production-change-2026

# --- AI-Юрист (GPTunnel / LLM API) ---
# Можно использовать GPTunnel или любой OpenAI-совместимый провайдер:
GPTUNNEL_API_KEY=
GPTUNNEL_BASE_URL=https://gptunnel.ru/v1
LLM_MODEL=deepseek-v4-pro-tunnelcode
VISION_LLM_MODEL=gemini-3.7-flash
# Опционально: прямой адрес эндпоинта /chat/completions (если используется не GPTunnel)
# LLM_API_URL=https://gptunnel.ru/v1/chat/completions
# LLM_API_KEY=
# LLM_TIMEOUT_S=35.0
