# ==============================================================================
# UtilityLens — Переменные окружения (.env.example)
# Скопируйте этот файл в .env перед запуском: cp .env.example .env
# ==============================================================================

# --- Настройки сервера и портов ---
BACKEND_PORT=8000
FRONTEND_PORT=8501
ENVIRONMENT=production

# --- CORS (разрешенные адреса для браузера и фронтенда) ---
CORS_ORIGINS=http://localhost:8501,http://localhost:3000,http://136.234.72.54,http://136.234.72.54:8000,http://25.vibe.fast.ru,http://25.vibe.fast.ru:8000

# --- База данных PostgreSQL ---
POSTGRES_DB=utilitylens
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/utilitylens

# --- Кэш Redis (хранение отчетов и сессий) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- AI-Юрист и GPTunnel (LLM API) ---
GPTUNNEL_API_KEY=
GPTUNNEL_BASE_URL=https://gptunnel.ru/v1
LLM_MODEL=gptunnel/deepseek-v4-pro-tunnelcode

# --- Фронтенд (Streamlit / Web) ---
USE_MOCK_API=false
API_BASE_URL=http://backend:8000
